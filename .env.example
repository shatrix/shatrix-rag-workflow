# ============================================================================
# rag-workflow configuration
#
# Copy this file to `.env` and edit it.  `.env` is gitignored and must never
# be committed.
#
# Precedence, highest first:
#   1. Real environment variables exported in your shell
#   2. Values in ./.env
#   3. The defaults below
#
# Run `./scripts/setup.sh` to create .env automatically, then
# `./scripts/doctor.py` to verify everything works.
# ============================================================================

# ── OpenRouter credentials ────────────────────────────────────────────────
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Only change this if you use an OpenRouter-compatible proxy.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional. OpenRouter uses these to attribute traffic to your app; they show
# up in your OpenRouter dashboard. No API behaviour depends on them.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=rag-workflow

# ── Models ────────────────────────────────────────────────────────────────

# Chat / answer-generation model.
#
# Every model listed in this file is a free OpenRouter endpoint: zero cost per
# input and output token. There are no paid options here on purpose, so a
# normal amount of personal use costs nothing.
RAG_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
#   -> 1M token context, up to 65536 completion tokens. A reasoning model, so
#      RAG_MAX_TOKENS must leave room for the reasoning trace.
#
# Other free chat models:
#   nvidia/nemotron-3.5-lightning:free
#
# To confirm a model is free before using it:
#   https://openrouter.ai/models   (free models are listed with a ":free"
#   suffix and a price of 0)
# Or check what your key can reach:
#   .venv/bin/python scripts/doctor.py

# Embedding model.  MUST be identical for indexing and querying, and the
# vector dimensionality is fixed by this choice -- changing it later requires
# wiping the collection and re-indexing (see README, "Changing models").
RAG_EMBED_MODEL=nvidia/nemotron-3-embed-1b:free
#   -> 2048 dimensions, accepts up to 32768 tokens per input.  Default choice.
#
# Alternative (smaller vectors, but a HARD 512-token input limit):
#   liquid/lfm-2.5-embedding-350m:free
#   -> 1024 dimensions.  If you pick this, keep RAG_CHUNK_CHARS at 1500 or
#      below or chunks will be silently truncated.
#
# Multimodal (text + image):
#   nvidia/llama-nemotron-embed-vl-1b-v2:free

# Optional: a vision-capable chat model used by markitdown to caption images.
# Leave empty to disable image uploads entirely. The free chat models above are
# text-only, so image uploads stay off unless you point this at a model that
# accepts image input.
RAG_VISION_MODEL=

# ── Retrieval behaviour ───────────────────────────────────────────────────
RAG_TOP_K=5
# Chunk sizing is in CHARACTERS, not tokens (rough rule: ~4 chars/token).
# 1800 chars ~= 450 tokens, a good default for RAG.
RAG_CHUNK_CHARS=1800
RAG_CHUNK_OVERLAP_CHARS=200
RAG_TEMPERATURE=0.2
RAG_MAX_TOKENS=1024
# Nemotron Ultra is a reasoning model. Set true to show its reasoning trace.
RAG_SHOW_REASONING=false
RAG_SHOW_SOURCES=true

# Optional: override the retrieval prompt used to answer questions.
RAG_SYSTEM_PROMPT=

# ── Vector store (ChromaDB) ───────────────────────────────────────────────
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8888
CHROMA_COLLECTION=rag_docs

# ── Storage ───────────────────────────────────────────────────────────────
# Relative paths are resolved against this repository's root.
RAG_DATA_DIR=data
RAG_DOCS_DIR=data/documents
CHROMA_DIR=data/chroma

# ── Web apps ──────────────────────────────────────────────────────────────
# Default is localhost only. The admin app has NO authentication, so do not
# change this to 0.0.0.0 on a network you do not fully control.
APP_BIND_ADDRESS=127.0.0.1
QUERY_APP_PORT=8901
ADMIN_APP_PORT=8902
# Streamlit's own upload ceiling, in megabytes. Keep in sync with MAX_FILE_MB.
APP_MAX_UPLOAD_MB=200

# ── Limits ────────────────────────────────────────────────────────────────
MAX_FILE_MB=200
MAX_FILES_PER_BATCH=50
# Safety valves for archive expansion.
MAX_ZIP_MEMBERS=500
MAX_ZIP_TOTAL_MB=500
# Reject archives that expand by more than this ratio (zip-bomb guard).
MAX_ZIP_EXPANSION_RATIO=100

# ── API tuning ────────────────────────────────────────────────────────────
# Free OpenRouter endpoints are rate limited per minute AND per day. Small
# batches with retries is the intended setup for free models.
EMBED_BATCH_SIZE=32
EMBED_MAX_RETRIES=5
API_TIMEOUT_SECONDS=120