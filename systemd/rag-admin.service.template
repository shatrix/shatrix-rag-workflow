# ============================================================================
# TEMPLATE -- not a valid unit until rendered by ./scripts/install-services.sh
#
#   ->  ~/.config/systemd/user/rag-admin.service
#
# NOTE: this interface has NO authentication. APP_BIND_ADDRESS defaults to
# 127.0.0.1 for that reason. Anyone who can reach the port can upload and
# delete documents.
# ============================================================================

[Unit]
Description=rag-workflow: document admin interface
Documentation=file://{{PROJECT_ROOT}}/README.md
After=network-online.target rag-chroma.service
Wants=network-online.target rag-chroma.service

[Service]
Type=simple
WorkingDirectory={{PROJECT_ROOT}}
EnvironmentFile=-{{PROJECT_ROOT}}/.env
Environment="PYTHONUNBUFFERED=1"
Environment="STREAMLIT_SERVER_HEADLESS=true"
Environment="STREAMLIT_BROWSER_GATHER_USAGE_STATS=false"

ExecStart={{VENV_DIR}}/bin/streamlit run {{PROJECT_ROOT}}/app/admin_app.py \
    --server.port {{ADMIN_PORT}} \
    --server.address {{BIND_ADDRESS}} \
    --server.headless true \
    --server.maxUploadSize {{MAX_UPLOAD_MB}} \
    --browser.gatherUsageStats false

Restart=always
RestartSec=5

# The admin app is the only component that writes to the data directory.
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target